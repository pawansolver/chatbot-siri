# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Configurable Gemini Model
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Language & Voice Configuration
LANGUAGE_MODE=auto

# Replaceable STT Engine
# Options: google (Google Speech API), gemini (Gemini Multimodal Audio), whisper (Local Whisper)
STT_ENGINE=google

# High-Quality Neural Voices
TTS_VOICE=en-IN-NeerjaNeural
TTS_VOICE_EN=en-US-AvaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_IN=en-IN-NeerjaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Assistant Personality
SYSTEM_INSTRUCTION="You are Aether, an intelligent, fast, and natural AI voice assistant. You fluently understand and speak English, Hindi (हिन्दी), and Hinglish. Always respond in the same language and style the user speaks (e.g. if the user speaks Hindi, reply in natural Hindi; if the user speaks Hinglish, reply in natural conversational Hinglish; if in English, reply in English). Keep your answers concise (1 to 3 sentences) so they sound crisp and engaging when spoken aloud. Avoid markdown tables, asterisks, or bulleted lists unless explicitly asked."
